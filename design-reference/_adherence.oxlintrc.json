        "selector": "JSXOpeningElement[name.name='Avatar'] > JSXAttribute[name.name='badge'] > Literal[value!=/^(?:success|warn|danger|info)$/]",
        "message": "<Avatar> badge must be one of 'success' | 'warn' | 'danger' | 'info'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|severity|dot|size|style|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: value, severity, dot, size, style."
